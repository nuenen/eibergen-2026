<body style="font-family: sans-serif; padding: 20px; background: #f5f5f5; color: #333;">
    <h1 style="margin-bottom: 16px; font-size: 24px;">📸 Reunie - Klassieke Foto's</h1>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        <!-- Foto 1 -->
        <article style="background: white; border-radius: 12px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.3s ease;">
